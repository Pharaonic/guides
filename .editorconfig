root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

# Guides are validated for trailing whitespace, so it is trimmed in Markdown too.
# Use a blank line instead of a trailing-space line break.

[*.{yml,yaml,json}]
indent_size = 2

[LICENSE*]
indent_size = unset
